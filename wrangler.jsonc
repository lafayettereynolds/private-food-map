{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "private-food-map",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "origin-api.tastemap.cn", "custom_domain": true },
    { "pattern": "api.tastemap.cn", "custom_domain": true },
    { "pattern": "tastemap.cn/.well-known/apple-app-site-association", "zone_name": "tastemap.cn" },
    { "pattern": "tastemap.cn/invite/*", "zone_name": "tastemap.cn" }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/ready", "/api/*", "/invite/*", "/.well-known/apple-app-site-association", "/internal/premium"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "food-map-db",
      "database_id": "064f6607-5464-4530-bc58-5f7d1e02f09f",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTO_STORAGE",
      "bucket_name": "taste-map-photos"
    }
  ],
  "vars": {
    "APP_ENVIRONMENT": "production",
    "SYNC_AUTH_MODE": "cloudflare-access",
    "APPLE_CLIENT_IDS": "com.lafayette.tastemap",
    "APP_STORE_BUNDLE_ID": "com.lafayette.tastemap",
    "APP_STORE_MONTHLY_PRODUCT_ID": "com.lafayette.tastemap.premium.monthly.v1",
    "APP_STORE_YEARLY_PRODUCT_ID": "com.lafayette.tastemap.premium.annual.v1",
    "APP_STORE_API_ENVIRONMENT": "production"
  },
  "observability": {
    "enabled": true
  }
}
