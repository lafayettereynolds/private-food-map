{
  "name": "private-food-map",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "pnpm run typecheck && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.worker.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:p0a": "node scripts/test-restaurant-identity-migration.mjs",
    "test:p0b1": "node scripts/test-sync-v1-migration.mjs && vitest run src/contracts/syncV1.test.ts worker/syncV1.integration.test.js",
    "preview": "vite preview --config vite.config.ts",
    "cloudflare:dev": "pnpm run build && wrangler dev --local",
    "d1:migrate:local": "wrangler d1 migrations apply food-map-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply food-map-db --remote",
    "seed:test-users": "wrangler d1 migrations apply food-map-db --local && node scripts/seed-test-users.mjs seed --environment development",
    "reset:test-users": "wrangler d1 migrations apply food-map-db --local && node scripts/seed-test-users.mjs reset --environment development",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.11",
    "wrangler": "4.124.0"
  }
}
