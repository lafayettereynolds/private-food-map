{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "private-food-map-development",
  "main": "./worker/index.ts",
  "alias": { "node-fetch": "./worker/appleNodeFetch.ts" },
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "api-dev.tastemap.cn",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "food-map-db-development",
      "database_id": "b1ddde34-c459-49bb-b9d1-7a41303ccb2d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTO_STORAGE",
      "bucket_name": "taste-map-photos-development"
    }
  ],
  "vars": {
    "APP_ENVIRONMENT": "development",
    "SYNC_AUTH_MODE": "cloudflare-access",
    "APPLE_CLIENT_IDS": "com.lafayette.tastemap",
    "APP_STORE_BUNDLE_ID": "com.lafayette.tastemap",
    "APP_STORE_MONTHLY_PRODUCT_ID": "com.lafayette.tastemap.premium.monthly.v1",
    "APP_STORE_YEARLY_PRODUCT_ID": "com.lafayette.tastemap.premium.annual.v1",
    "APP_STORE_API_ENVIRONMENT": "sandbox"
  },
  "observability": {
    "enabled": true
  }
}
